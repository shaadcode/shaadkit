{
  "editor.formatOnSave": false,

  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "search.exclude": {
    "node_modules": true,
    ".next": true,
    "next-env.d.ts": true,
    "bun.lock": true
  },
  "oxc.configPath": "./oxlint.config.mts",
  "oxc.enable.oxlint": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "oxc.typeAware": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // useRouter should be imported from `next/navigation` instead of `next/router`
    "next/router",
    "^(node:)?os$",
    // By using the Anchor component from Mantine, you get the benefits of Mantine, Next.js, and Next-Intl at the same time.
    "@/config/nextIntl/navigation",
    "next/dist/client/link",
    "next/dist/api/link",
    "process",
    "node:process",
    "console",
    "node:inspector",
    "inspector",
    "node:inspector/promises",
    "inspector/promises"
  ],
  "js/ts.preferences.autoImportFileExcludePatterns": ["node:console"],
  "js/ts.preferences.preferTypeOnlyAutoImports": true, // Prefer type-only imports
  "editor.wordWrap": "on",
  "workbench.iconTheme": "material-icon-theme",
  "editor.tabCompletion": "on",
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
